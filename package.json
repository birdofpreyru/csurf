{
  "name": "@dr.pogodin/csurf",
  "description": "CSRF token middleware for ExpressJS",
  "version": "1.18.2",
  "license": "MIT",
  "repository": "github:birdofpreyru/csurf",
  "bugs": {
    "url": "https://github.com/birdofpreyru/csurf/issues"
  },
  "homepage": "https://dr.pogodin.studio/docs/csurf",
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "exports": {
    "types": "./build/index.d.ts",
    "default": "./build/index.js"
  },
  "dependencies": {
    "cookie": "^2.0.1",
    "cookie-signature": "^1.2.2",
    "http-errors": "^2.0.1"
  },
  "devDependencies": {
    "@babel/cli": "^8.0.6",
    "@babel/core": "^8.0.7",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-typescript": "^8.0.7",
    "@dr.pogodin/babel-plugin-add-import-extension": "^3.0.2",
    "@dr.pogodin/eslint-configs": "^0.3.7",
    "@jest/globals": "^30.5.2",
    "@tsconfig/recommended": "^1.0.13",
    "@types/cookie-parser": "^1.4.10",
    "@types/cookie-session": "^2.0.49",
    "@types/cookie-signature": "^1.1.2",
    "@types/express": "^5.0.6",
    "@types/http-errors": "^2.0.5",
    "@types/jest": "^30.0.0",
    "@types/supertest": "^7.2.1",
    "body-parser": "^2.3.0",
    "cookie-parser": "^1.4.7",
    "cookie-session": "^2.1.1",
    "express": "^5.2.1",
    "jest": "^30.5.2",
    "rimraf": "^6.1.3",
    "supertest": "^7.3.1",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rimraf build && npm run build:types && npm run build:logic",
    "build:logic": "BABEL_ENV=production babel src -x .ts --out-dir build --source-maps --config-file ./babel.build.config.js",
    "build:types": "tsc --project tsconfig.types.json",
    "lint": "eslint --cache --cache-strategy content",
    "jest": "NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" jest",
    "test": "npm run lint && npm run jest"
  },
  "keywords": [
    "express",
    "csrf",
    "csurf",
    "tokens",
    "middleware",
    "javascript",
    "tools",
    "utils"
  ],
  "type": "module"
}
