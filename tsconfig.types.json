{
  "extends": "@tsconfig/recommended",
  "include": ["src"],
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "isolatedModules": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "build",
    "rootDir": "./src",
    "strict": true,
    "verbatimModuleSyntax": true
  }
}
